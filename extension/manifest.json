{
  "manifest_version": 3,
  "name": "Sherpa — Guide Me",
  "version": "1.0.0",
  "description": "A friendly helper that points at exactly what to click, on any website, and reads each step out loud.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel", "clipboardWrite", "audioCapture"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open Sherpa",
    "default_icon": {
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "simplify.js"],
      "css": ["content.css", "simplify.css"],

      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
